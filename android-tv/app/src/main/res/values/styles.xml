<resources>
    <style name="Theme.GmmTv" parent="Theme.AppCompat.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:colorAccent">@color/gmm_primary</item>
        <item name="android:navigationBarColor">@color/gmm_background</item>
        <item name="android:windowBackground">@color/gmm_background</item>
        <item name="android:buttonStyle">@style/Widget.GmmButton</item>
    </style>
    <style name="Widget.GmmButton" parent="android:style/Widget.Button">
        <item name="android:background">@drawable/gmm_button</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">96dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>
